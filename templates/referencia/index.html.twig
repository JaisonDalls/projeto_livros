{% extends 'base.html.twig' %}

{% block title %}{{ pageTitle }} — Acervo Aberto{% endblock %}

{% block body %}
    <div class="site-shell">
        <header class="site-header">
            <a class="brand" href="{{ path('app_home') }}">
                <span class="brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M4.75 6.5h5.1A2.65 2.65 0 0 1 12.5 9.15v9.1a2.65 2.65 0 0 0-2.65-2.65h-5.1V6.5Zm14.5 0h-5.1a2.65 2.65 0 0 0-2.65 2.65v9.1a2.65 2.65 0 0 1 2.65-2.65h5.1V6.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    </svg>
                </span>
                <span>Acervo Aberto</span>
            </a>
            <nav class="header-actions" aria-label="Navegação principal">
                <a class="nav-link" href="{{ path('autor_index') }}">Autores</a>
                <a class="nav-link" href="{{ path('assunto_index') }}">Assuntos</a>
                <a class="nav-link" href="{{ path('app_home') }}">Catálogo</a>
            </nav>
        </header>

        <main class="catalog-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Cadastros auxiliares</p>
                    <h1>{{ pageTitle }}</h1>
                </div>
                <a class="btn btn-success" href="{{ path(newRoute) }}">Cadastrar</a>
            </div>

            <div class="reference-list">
                {% for item in items %}
                    <div class="reference-row">
                        <span>{{ item.label }}</span>
                        <div class="book-actions">
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path(editRoute, {id: item.id}) }}">Editar</a>
                            <form method="post" action="{{ path(deleteRoute, {id: item.id}) }}" onsubmit="return confirm('Excluir este cadastro?');">
                                <input type="hidden" name="_token" value="{{ csrf_token(deleteTokenPrefix ~ item.id) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button>
                            </form>
                        </div>
                    </div>
                {% else %}
                    <p class="empty-state">Nenhum cadastro encontrado.</p>
                {% endfor %}
            </div>
        </main>

        <footer class="site-footer">
            <p>Acervo Aberto · Consulte e organize suas leituras.</p>
        </footer>
    </div>
{% endblock %}
