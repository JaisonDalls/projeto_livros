{% extends 'layout/site.html.twig' %}

{% block title %}{{ pageTitle }} — Acervo Aberto{% endblock %}

{% block content %}
        <main class="catalog-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Cadastros auxiliares</p>
                    <h1>{{ pageTitle }}</h1>
                </div>
                <a class="btn btn-success" href="{{ path(newRoute) }}">Cadastrar</a>
            </div>

            {% if items is not empty %}
                <div class="reference-search">
                    <label class="visually-hidden" for="reference-search">Pesquisar {{ pageTitle|lower }}</label>
                    <input
                        id="reference-search"
                        type="search"
                        placeholder="Pesquisar {{ pageTitle|lower }}..."
                        autocomplete="off"
                        data-reference-search
                        aria-controls="reference-list"
                    >
                </div>
            {% endif %}

            <div class="reference-list" id="reference-list">
                {% for item in items %}
                    <div class="reference-row" data-reference-item>
                        <span data-reference-label>{{ item.label }}</span>
                        <div class="book-actions">
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path(editRoute, {id: item.id}) }}">Editar</a>
                            <form method="post" action="{{ path(deleteRoute, {id: item.id}) }}" onsubmit="return confirm('Excluir este cadastro?');">
                                <input type="hidden" name="_token" value="{{ csrf_token(deleteTokenPrefix ~ item.id) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button>
                            </form>
                        </div>
                    </div>
                {% else %}
                    <p class="empty-state">Nenhum cadastro encontrado.</p>
                {% endfor %}
                {% if items is not empty %}
                    <p class="empty-state" data-reference-empty role="status" aria-live="polite" hidden>Nenhum resultado para a pesquisa.</p>
                {% endif %}
            </div>
        </main>

{% endblock %}
