{% extends 'layout/site.html.twig' %}

{% block title %}{{ pageTitle }} — Acervo Aberto{% endblock %}

{% block content %}
        <main class="catalog-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Gestão do acervo</p>
                    <h1>{{ pageTitle }}</h1>
                </div>
            </div>

            {{ form_start(form, {attr: {class: 'book-form'}}) }}
                {{ form_errors(form) }}

                <div class="book-form-grid">
                    <div class="field">{{ form_row(form.titulo) }}</div>
                    <div class="field">{{ form_row(form.editora) }}</div>
                    <div class="field">{{ form_row(form.edicao) }}</div>
                    <div class="field">{{ form_row(form.anoPublicacao) }}</div>
                    <div class="field">{{ form_row(form.valor) }}</div>
                </div>

                {% include 'components/tag_input_group.html.twig' with {
                    legend: 'Autores',
                    field: form.autoresTexto,
                    options: autoresDisponiveis,
                    help: 'Digite para buscar um autor existente ou informe um novo. Use ponto e vírgula ou Enter para adicionar; novos autores serão cadastrados ao salvar.'
                } only %}

                {% include 'components/tag_input_group.html.twig' with {
                    legend: 'Assuntos',
                    field: form.assuntosTexto,
                    options: assuntosDisponiveis,
                    help: 'Digite para buscar um assunto existente ou informe um novo. Use ponto e vírgula ou Enter para adicionar; novos assuntos serão cadastrados ao salvar.'
                } only %}

                <div class="form-actions">
                    <button class="btn btn-success" type="submit">{{ submitLabel }}</button>
                    <a class="btn btn-outline-secondary" href="{{ path('app_home') }}">Cancelar</a>
                </div>
            {{ form_end(form) }}
        </main>

{% endblock %}
